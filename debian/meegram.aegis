<aegis>
    <!-- The credential meegramd checks a connecting UI for. Namespaced by package name by
         aegis itself, so the daemon looks for "meegram::Client".

         It exists because the socket in $HOME carries a logged-in Telegram session, and
         the check that used to guard it - comparing the peer's /proc/<pid>/exe against the
         binary installed next to meegramd - cannot work on a device with aegis enforcing:
         the UI below is granted credentials, a credentialed process is not dumpable, and
         an unprivileged daemon gets EACCES reading its /proc entry. A token is held by the
         kernel against the connection instead, so verifying it needs no privilege at all.

         Granted to the UI only. meegramd requests nothing: it is the one checking. -->
    <provide>
        <credential name="Client" />
    </provide>

    <request policy="add">
        <credential name="meegram::Client" />

        <credential name="Location" />
        <credential name="TrackerReadAccess" />
        <credential name="TrackerWriteAccess" />
        <!-- Two things now: reading the gallery index for the photo picker, and the
             camera the QR scanner reads frames from - both go through the same GStreamer
             pipeline. Harmattan has no camera-specific credential; this is the one that
             covers video.

             Unverified for the camera: this device runs aegis in open mode, which enforces
             nothing, so a missing credential here would only show up on a closed-mode
             phone - silently, as a viewfinder that stays black. Run accli -I on one. -->
        <credential name="GRP::video" />

        <for path="/opt/meegram/bin/meegram" />
        <for path="applauncherd-launcher::/usr/bin/applauncherd.bin" id="" />
    </request>

    <request context="INSTALL" >
        <credential name="UID::user" />
        <credential name="GID::users" />
    </request>
</aegis>
