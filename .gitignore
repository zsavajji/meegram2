*.dylib

# Qt-es
object_script.*.Release
object_script.*.Debug
*_plugin_import.cpp
/.qmake.cache
/.qmake.stash
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
Makefile*
# Directory-only: a bare *build* also swallows files such as BUILDING.md and
# tools/build-toolchain.sh, which then never show up as untracked.
*build*/
*.qm
*.prl

# Qt unit tests
target_wrapper.*

# QtCreator
*.autosave

# QtCreator Qml
*.qmlproject.user
*.qmlproject.user.*

# QtCreator CMake
CMakeLists.txt.user*

# QtCreator 4.8< compilation database 
compile_commands.json

# QtCreator local machine specific files for imported projects
*creator.user*

# macOS
.DS_Store

# VitePress docs site (self-contained in docs/).
# The **/ prefix matters: a pattern containing a slash is anchored to this file's
# directory, so a bare .vitepress/dist/ would only match one at the repo root.
node_modules/
**/.vitepress/dist/
**/.vitepress/cache/

# graphify: generated knowledge-graph output, rebuilt from the sources
graphify-out/

# build artifacts
*.deb
*.changes
*.tar.xz
*.tar.gz

# submodules
openssl-*/
zlib*/
